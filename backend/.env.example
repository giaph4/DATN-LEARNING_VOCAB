# Copy to backend/.env to override defaults (compose.yaml and the IDE run config read the same names).
# Dev-only values — never commit real secrets. Section 15.2 of THIET_KE lists the production set.

# Ports on your machine
MYSQL_PORT=3307
REDIS_PORT=6379
API_PORT=8080

# MySQL — one app user for Flyway + API (created automatically on first start)
DB_URL=jdbc:mysql://localhost:3307/vocab_learning?connectionTimeZone=UTC&characterEncoding=UTF-8
DB_USER=vocab
DB_PASSWORD=vocab_dev_pw
DB_ROOT_PASSWORD=root_dev_pw

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PASSWORD=

# S3 / MinIO (public endpoint = what the browser uses for presigned URLs)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=vocab-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Mail (Mailpit)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# App
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_COOKIE_SECURE=false

# External APIs (empty = offline fake clients)
AI_FAKE=true
LLM_PROVIDER_API_KEY=
SPEECH_FAKE=true
SPEECH_PROVIDER_KEY=
SPEECH_PROVIDER_REGION=southeastasia

# Google login (Đợt 1, TK-03). Trống = tắt nút Google (API trả 404 cho /oauth2/authorization/google).
# Google Cloud Console → OAuth client "Web": Authorized redirect URI = http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
